# Environment Configuration for Smart Contracts

# Network RPC URLs
NEUROMESH_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Private Keys (DO NOT COMMIT THESE)
PRIVATE_KEY=your_private_key_here
MNEMONIC=test test test test test test test test test test test junk

# Block Explorer API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Gas Reporter
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Contract Addresses (populated after deployment)
MESH_TOKEN_ADDRESS=
AGENT_EXECUTOR_ADDRESS=
BRIDGE_EXTENSION_ADDRESS=
ZKML_VERIFIER_ADDRESS=
KYA_REGISTRY_ADDRESS=
