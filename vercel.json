{
  "version": 2,
  "builds": [
    {
      "src": "frontend/neuromesh-ui/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/neuromesh-ui/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/frontend/neuromesh-ui/dist/$1"
    }
  ],
  "buildCommand": "cd frontend/neuromesh-ui && npm install && npm run build",
  "outputDirectory": "frontend/neuromesh-ui/dist",
  "framework": "vite",
  "installCommand": "cd frontend/neuromesh-ui && npm install"
}
