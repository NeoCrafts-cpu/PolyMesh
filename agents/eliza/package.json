{
  "name": "@PolyMesh/eliza-agent",
  "version": "0.1.0",
  "description": "AI Agent for PolyMesh using Eliza framework",
  "type": "module",
  "scripts": {
    "start": "node --loader ts-node/esm src/index.ts",
    "dev": "nodemon --exec node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "render": "node --loader ts-node/esm src/index.ts"
  },
  "keywords": [
    "ai-agent",
    "eliza",
    "polygon",
    "web3"
  ],
  "author": "PolyMesh Team",
  "license": "MIT",
  "dependencies": {
    "@ai16z/eliza": "^0.1.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "ws": "^8.14.2",
    "typescript": "^5.3.3",
    "@types/node": "^20.19.25",
    "@types/ws": "^8.5.10"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2"
  }
}


