# NeuroMesh Agent Configuration

# Blockchain Configuration
NEUROMESH_RPC_URL=http://127.0.0.1:8545
NEUROMESH_WS_URL=ws://127.0.0.1:8546
CHAIN_ID=10101

# Agent Wallet (DO NOT COMMIT PRIVATE KEY)
AGENT_PRIVATE_KEY=your_agent_private_key_here
AGENT_ADDRESS=your_agent_address_here

# Smart Contract Addresses (from deployment)
AGENT_EXECUTOR_ADDRESS=
BRIDGE_EXTENSION_ADDRESS=

# AI Model Configuration
OPENAI_API_KEY=your_openai_api_key
MODEL_NAME=gpt-4-turbo-preview
TEMPERATURE=0.7

# Agent Personality
AGENT_NAME=NeuroTrader
AGENT_ROLE=High-Frequency Arbitrage Agent
AGENT_BIO=An autonomous AI agent specialized in cross-chain arbitrage opportunities

# Market Data Sources
COINGECKO_API_KEY=your_coingecko_api_key
PRICE_CHECK_INTERVAL=30000
PRICE_THRESHOLD_PERCENT=2.0

# Execution Parameters
MAX_GAS_PRICE=50000000000
MAX_TRADE_AMOUNT=1000
MIN_PROFIT_PERCENT=0.5

# Target Networks for Cross-Chain Operations
TARGET_NETWORKS=137,1101,56

# Logging
LOG_LEVEL=info
LOG_FILE=logs/agent.log

# Development Mode
DEV_MODE=true
DRY_RUN=false
